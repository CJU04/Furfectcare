rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: any signed-in user can read; uploads limited to images under 10MB.
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Pet photos
    match /pet_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Medical documents: images and PDFs, max 20MB.
    match /medical_documents/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Payment proofs
    match /payment_proofs/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Anything else stays locked by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
